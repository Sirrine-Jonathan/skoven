# Skoven Companion App — Environment Variables
# Copy this file to .env and fill in the values for your chosen provider.
# Never commit .env to git.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: ollama | openai | anthropic | openrouter | custom
# Default is 'ollama' for 100% free, local, private execution without API keys.
SKOVEN_LLM_PROVIDER=ollama

# Override the default model for your chosen provider (optional)
# Default per provider:
#   ollama      → qwen2.5-coder:7b (or muse-glimmer:30b-mlx, llama3.1:8b)
#   openai      → gpt-4o
#   anthropic   → claude-3-5-sonnet-20241022
#   openrouter  → anthropic/claude-3.5-sonnet
#   custom      → default
SKOVEN_LLM_MODEL=qwen2.5-coder:7b

# ── Local Ollama & Muse Spark (No API key needed) ────────────────────────────
# Download Ollama at https://ollama.ai
# Supported local models: qwen2.5-coder:7b, muse-glimmer:30b-mlx, etc.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ── STT Backend ───────────────────────────────────────────────────────────────
# auto           — tries OpenAI Whisper if key present; falls back to local whisper.cpp
# local_whisper  — 100% offline whisper.cpp using Apple Silicon Metal acceleration
# openai_whisper — sends audio to OpenAI Whisper API (requires OPENAI_API_KEY)
# passthrough    — Quest sends pre-transcribed text; used for desktop testing
SKOVEN_STT_BACKEND=auto

# Optional custom paths for whisper.cpp:
# WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_CPP_MODEL=/Users/jonathansirrine/.cache/whisper.cpp/ggml-base.en.bin

# ── Cloud API Keys (Optional - only if using cloud providers) ────────────────
# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — https://openrouter.ai/keys
# Gives access to 100+ models: Gemini, Mistral, Llama, Cohere, Perplexity, etc.
# Models use format "provider/model-name" e.g. "google/gemini-pro-1.5"
# OPENROUTER_API_KEY=sk-or-...
# SKOVEN_LLM_MODEL=anthropic/claude-3.5-sonnet

# Ollama (local, no API key needed)
# Download at https://ollama.ai — run: ollama pull llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Custom OpenAI-compatible endpoint (LM Studio, vLLM, Together AI, Groq, etc.)
# SKOVEN_CUSTOM_LLM_BASE_URL=http://localhost:1234/v1
# SKOVEN_CUSTOM_LLM_API_KEY=your-key-here
# SKOVEN_CUSTOM_LLM_MODEL=your-model-name

# ── STT Backend ───────────────────────────────────────────────────────────────
# openai_whisper — sends audio to OpenAI Whisper API (requires OPENAI_API_KEY)
# passthrough    — Quest sends pre-transcribed text; used for desktop testing
SKOVEN_STT_BACKEND=openai_whisper

# ── Server ────────────────────────────────────────────────────────────────────
# WebSocket port the Quest connects to
SKOVEN_PORT=8765

# Allowed Quest device IDs (comma-separated). Leave blank to allow any (dev only).
# SKOVEN_ALLOWED_DEVICES=quest3-device-id-here

# ── Default project ───────────────────────────────────────────────────────────
# Absolute path to the git repo to open automatically on Quest connection.
# Can be overridden by the Quest app at runtime.
# SKOVEN_DEFAULT_PROJECT=/Users/you/dev/your-project

# ── Safety ────────────────────────────────────────────────────────────────────
# Comma-separated shell commands the agent may run in the verify stage.
# Destructive commands (force push, drop, rm -rf) are blocked regardless.
SKOVEN_ALLOWED_COMMANDS=npm test,npm run lint,npm run build,npx tsc --noEmit,yarn test,yarn lint,pnpm test,pnpm lint,cargo test,cargo check,go test ./...,pytest,python -m pytest,make test,make lint
